---
// Zwei-Klick-Lösung: YouTube wird erst nach einem Klick geladen.
// Das Vorschaubild kommt von uns, nicht von YouTube, damit vorher keine Daten fließen.
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  poster: ImageMetadata;
  label?: string;
}
const { id, title, poster, label = 'Video abspielen' } = Astro.props;
---
<figure class="yt">
  <div class="yt-frame" data-yt={id} data-title={title}>
    <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 72rem) 72rem, 100vw" />
    <button type="button" class="yt-play">
      <span class="yt-icon" aria-hidden="true">▶</span>
      <span>{label}</span>
      <small>Beim Abspielen wird eine Verbindung zu YouTube (Google) hergestellt. <a href="/datenschutz/#youtube">Mehr erfahren</a></small>
    </button>
  </div>
  <figcaption class="muted">
    {title} · <a href={`https://www.youtube.com/watch?v=${id}`} rel="noopener">direkt auf YouTube ansehen</a>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.yt-frame').forEach((frame) => {
    frame.querySelector('.yt-play')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.title ?? 'YouTube-Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    });
  });
</script>

<style>
  .yt { margin: 0; }
  .yt-frame { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; }
  .yt-frame :global(img), .yt-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .yt-frame :global(img) { filter: brightness(0.55); }
  .yt-play {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;
    background: transparent; border: 0; color: var(--fg); cursor: pointer;
    font-family: var(--display); text-transform: uppercase; letter-spacing: 0.06em; font-size: 1.25rem;
    padding: 1rem;
  }
  .yt-icon {
    display: grid; place-items: center;
    width: 4.5rem; height: 4.5rem; border-radius: 50%;
    background: var(--red); color: #fff; font-size: 1.75rem; padding-left: 0.3rem;
    transition: transform 0.15s;
  }
  .yt-play:hover .yt-icon { transform: scale(1.08); }
  .yt-play small { font-family: var(--body); text-transform: none; letter-spacing: 0; font-size: 0.85rem; color: var(--muted); max-width: 28rem; text-align: center; }
  figcaption { font-size: 0.95rem; margin-top: 0.75rem; }
</style>
