        <a class="btn" href="/">Startseite</a>
        <a class="btn btn--ghost" href="/das-uni-musical/">Das Uni-Musical</a>
        <a class="btn btn--ghost" href="/mitwirkende/">Mitwirkende</a>
      </div>
    </div>
  </section>
</Base>
